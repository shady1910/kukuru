{
  "name": "kukuru",
  "version": "1.0.0",
  "private": true,
  "description": "Website der kukuru House-Eventreihe aus Moers",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./style.css -o ./site.css",
    "dev:css": "tailwindcss -i ./style.css -o ./site.css --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "htmlhint \"**/*.html\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shady1910/kukuru.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shady1910/kukuru/issues"
  },
  "homepage": "https://github.com/shady1910/kukuru#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "htmlhint": "^1.9.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.5"
  }
}
